# The Medusa admin dashboard (apps/backend's transitive dependency tree,
# via @medusajs/admin-bundler -> @medusajs/dashboard -> radix-ui) pulls in
# @types/react@18.x peer expectations, while the Expo/React Native apps
# (apps/mobile-customer, apps/mobile-seller, packages/mobile-ui) require
# @types/react@19.x / react-native's own peer set. Both ecosystems are
# genuinely correct in isolation - npm's default strict peer-dependency
# resolution just can't satisfy both trees simultaneously in one flat
# node_modules. legacy-peer-deps relaxes that to a warning instead of a
# hard install failure; each workspace still resolves its own actually-
# declared dependency versions correctly at runtime.
legacy-peer-deps=true
