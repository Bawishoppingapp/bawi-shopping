# Copy to .env for local development. Placeholders only - no real secrets.
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:3002
AUTH_CORS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:9000

# Generate your own values for these - do not reuse the placeholders below.
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-long-random-string
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-64-char-hex-string

# Local Postgres.app instance (see docs/DECISIONS.md) - adjust host/port/user
# to match your own local Postgres if different.
DATABASE_URL=postgresql://postgres@127.0.0.1:5544/bawi_shopping_dev

# Unused until the background-jobs/payouts slice - safe to leave unset locally.
REDIS_URL=redis://localhost:6379

# Used to build the seller account-activation link returned by the admin
# approve-application action (see docs/MARKETPLACE-FLOWS.md).
SELLER_PORTAL_URL=http://localhost:3001
# The courier portal lives inside apps/admin (see docs/DECISIONS.md), not a
# dedicated 6th app - hence port 3002 (admin's own port) plus /courier.
COURIER_PORTAL_URL=http://localhost:3002/courier

# Test-only: enables /seller-test-support/* routes AND switches the Stripe
# client to a network-free fake (see docs/DECISIONS.md). Never set true
# outside local/test runs.
ENABLE_TEST_SUPPORT_ROUTES=false

# Stripe Connect (test mode only - see docs/PAYMENTS.md, docs/DECISIONS.md).
# Leave both unset for local dev without a real Stripe account: with
# ENABLE_TEST_SUPPORT_ROUTES=true above, a network-free fake Stripe client
# is used instead and onboarding/webhooks work end to end without either
# of these. Set both to real Stripe TEST-mode values (sk_test_... /
# whsec_...) to exercise the real Stripe test API. NEVER put a live
# (sk_live_.../whsec_... for a live endpoint) key here or in any committed
# file - live credentials are configured directly in the deployment
# environment, never checked into source control, and only ever used after
# an explicit, separate production-launch approval.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
