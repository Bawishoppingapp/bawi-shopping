# Copy to .env for local development. Placeholders only - no real secrets.
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:3002
AUTH_CORS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:9000

# Generate your own values for these - do not reuse the placeholders below.
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-long-random-string
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-64-char-hex-string

# Local Postgres.app instance (see docs/DECISIONS.md) - adjust host/port/user
# to match your own local Postgres if different.
DATABASE_URL=postgresql://postgres@127.0.0.1:5544/bawi_shopping_dev

# Unused until the background-jobs/payouts slice - safe to leave unset locally.
REDIS_URL=redis://localhost:6379

# Used to build the seller account-activation link returned by the admin
# approve-application action (see docs/MARKETPLACE-FLOWS.md).
SELLER_PORTAL_URL=http://localhost:3001

# Test-only: enables /seller-test-support/* routes. Never set true outside
# local/test runs - see docs/DECISIONS.md.
ENABLE_TEST_SUPPORT_ROUTES=false
