# Production environment template for apps/backend. Copy to the hosting
# provider's secret manager (never to a committed .env file) and replace
# every placeholder below. See docs/DEPLOYMENT.md for what each variable
# does and docs/LAUNCH-CHECKLIST.md for the full pre-launch checklist.
#
# Every value here is a PLACEHOLDER. Nothing in this file, by itself,
# turns on live payments, live transfers, live email, live SMS, or any
# other real-operation feature flag - those are business-config feature
# flags (see docs/DEPLOYMENT.md §4.3), flipped deliberately and
# separately, never implied by an env var alone.

# --- Core (all required) ---
DATABASE_URL=postgresql://replace-user:replace-password@replace-production-db-host:5432/bawi_shopping_production
STORE_CORS=https://shop.example.com
ADMIN_CORS=https://admin.example.com
AUTH_CORS=https://shop.example.com,https://sell.example.com,https://admin.example.com

# --- Secrets (all required, all Yes-Secret - generate fresh values,
# never reuse across environments, never commit) ---
JWT_SECRET=replace-with-a-long-random-string-unique-to-production
COOKIE_SECRET=replace-with-a-long-random-string-unique-to-production
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-64-char-hex-string-unique-to-production

# --- URLs the backend builds links from (all required) ---
SELLER_PORTAL_URL=https://sell.example.com
COURIER_PORTAL_URL=https://admin.example.com/courier

# --- Must be false/unset in production. Never set to true here. ---
ENABLE_TEST_SUPPORT_ROUTES=false

# --- Stripe (see docs/DEPLOYMENT.md §8 for the exact go-live sequence).
# Keep TEST-mode keys here until an explicit, separate production-launch
# approval - the master switch is business-config's live_payments_enabled
# flag, not this file, but a live key should still never be set before
# that approval. ---
STRIPE_SECRET_KEY=sk_test_replace-with-a-real-test-mode-key
ETHIOPIAN_PAYMENT_PROVIDER=disabled
STRIPE_WEBHOOK_SECRET=whsec_replace-with-this-environments-webhook-signing-secret

# --- Email (optional - leave EMAIL_PROVIDER blank to keep using
# notification-local, i.e. no email actually sends, until
# real_email_enabled is turned on) ---
EMAIL_PROVIDER=
SENDGRID_API_KEY=replace-with-a-real-sendgrid-api-key
SENDGRID_FROM_EMAIL=orders@example.com

# --- Object storage (optional - leave blank to keep using local-disk
# storage; NOT recommended for a real multi-instance/ephemeral production
# deployment - see docs/DEPLOYMENT.md §9). If running on AWS (e.g. via
# infra/terraform), leave S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY BOTH
# blank - the ECS task's IAM role supplies credentials automatically
# (see infra/terraform/iam.tf). Only set them explicitly for a non-AWS
# S3-compatible provider. ---
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=replace-with-a-real-bucket-name
S3_ENDPOINT=

# --- Redis (required once running more than one backend instance - see
# docs/DEPLOYMENT.md §9) ---
REDIS_URL=redis://replace-production-redis-host:6379
