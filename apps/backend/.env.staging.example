# Staging template for the low-cost path (Vercel + Render/Railway +
# Supabase) - see docs/DEPLOYMENT-LOWCOST.md for full context on every
# value below. Copy these into Render/Railway's own env var UI - never
# into a committed .env file. Every value here is a placeholder.
#
# This file intentionally omits the AWS-specific guidance in
# .env.production.example (ECS task IAM role S3 auth, etc.) - that path
# doesn't apply here.

# --- Core (all required) ---
# Supabase "Direct connection" string, NOT the pooler - see
# docs/DEPLOYMENT-LOWCOST.md §2. No query params needed - TLS
# verification is handled by DATABASE_SSL_REJECT_UNAUTHORIZED below, not
# a ?sslmode=... suffix here (Medusa's own connection loader overrides
# anything parsed from the URL - confirmed against a real failed deploy).
DATABASE_URL=postgresql://postgres:replace-with-supabase-password@db.replace-project-ref.supabase.co:5432/postgres

# Required for Supabase - its certificate chain fails Node's default
# strict verification from a generic client. Leave unset for AWS RDS or
# local/CI Postgres.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
STORE_CORS=https://replace-storefront.vercel.app
ADMIN_CORS=https://replace-admin.vercel.app
AUTH_CORS=https://replace-storefront.vercel.app,https://replace-seller-portal.vercel.app,https://replace-admin.vercel.app

# --- Secrets (all required - generate fresh, never reuse, never commit) ---
JWT_SECRET=replace-with-openssl-rand-hex-32-output
COOKIE_SECRET=replace-with-openssl-rand-hex-32-output
AUTH_MFA_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-output

# --- URLs the backend builds links from (all required) ---
SELLER_PORTAL_URL=https://replace-seller-portal.vercel.app
COURIER_PORTAL_URL=https://replace-admin.vercel.app/courier

# --- Must stay false/unset outside CI. Never set to true here. ---
ENABLE_TEST_SUPPORT_ROUTES=false

# --- Stripe TEST MODE ONLY - never a live (sk_live_/pk_live_) key here.
# STRIPE_WEBHOOK_SECRET only exists after the backend has a real URL and
# the webhook endpoint is registered - see docs/DEPLOYMENT-LOWCOST.md §5.
STRIPE_SECRET_KEY=sk_test_replace-with-a-real-test-mode-key
ETHIOPIAN_PAYMENT_PROVIDER=disabled
STRIPE_WEBHOOK_SECRET=whsec_replace-with-this-environments-webhook-signing-secret

# --- Email (leave EMAIL_PROVIDER blank - notification-local only, no
# email actually sends, until a deliberate later real_email_enabled
# decision - not part of this staging deployment) ---
EMAIL_PROVIDER=
BREVO_API_KEY=replace-with-a-real-brevo-api-key
BREVO_FROM_EMAIL=support@bawishopping.com
BREVO_FROM_NAME=Bawi Shopping
PASSWORD_RESET_URL_BASE=mobilecustomer://reset-password

# --- Object storage (optional - leave blank for local disk, which is
# ephemeral on Render/Railway; see docs/DEPLOYMENT-LOWCOST.md §5 "Object
# storage" for the Cloudflare R2 free-tier alternative) ---
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- Redis: intentionally omitted. Not required for a single free-tier
# instance - see docs/DEPLOYMENT-LOWCOST.md's Architecture section. ---
