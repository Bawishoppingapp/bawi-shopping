{
  "name": "@bawi/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "test": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:integration": "npm run test:integration:modules && npm run test:integration:http",
    "test:integration:http": "medusa build && node integration-tests/http/ensure-admin.js && TEST_TYPE=integration:http NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=96' jest --silent=false --runInBand --forceExit --passWithNoTests",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=1024' jest --silent=false --runInBand --forceExit --passWithNoTests"
  },
  "dependencies": {
    "@bawi/search-contract": "*",
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/admin-shared": "2.19.0",
    "@medusajs/cache-redis": "2.19.0",
    "@medusajs/caching": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/dashboard": "2.19.0",
    "@medusajs/draft-order": "2.19.0",
    "@medusajs/event-bus-redis": "2.19.0",
    "@medusajs/file-s3": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/locking-redis": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/notification-local": "2.19.0",
    "@medusajs/notification-sendgrid": "2.19.0",
    "@medusajs/ui": "4.1.19",
    "@medusajs/workflow-engine-redis": "2.19.0",
    "@tanstack/react-query": "5.64.2",
    "multer": "^2.3.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.6",
    "stripe": "^22.3.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.19.0",
    "@medusajs/test-utils": "2.19.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "pg-god": "^1.0.12",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.12.1"
}
