# Expo inlines any EXPO_PUBLIC_-prefixed var into the JS bundle at build
# time (no extra package needed - built into the Expo SDK). Copy this to
# .env.local for local development.
EXPO_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
EXPO_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Added when the Stripe checkout phase is built (see docs plan) - not
# needed yet.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
