{
  "expo": {
    "name": "Bawi Shopping",
    "slug": "mobile-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobilecustomer",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.bawishopping.mobilecustomer",
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bawi Shopping to select product photos for your storefront.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#151210"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e30978d1-5eba-436c-a56d-f812fdd6e3f0"
      }
    },
    "owner": "bawishopping",
    "ios": {
      "bundleIdentifier": "com.bawishopping.mobilecustomer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
